@model IEnumerable<Tp_Inmobiliaria_Ledesma_Lillo.Models.Contrato>

@{
    ViewData["Title"] = "Contrato";
    var listaVacia = ViewBag.ListaVacia;
}

<h1>Contratos</h1>
<div class="container">
    <div class="row">
        <div class="col-2">
            <a asp-action="Crear" title="Nuevo Contrato"><i class="btn btn-primary"> Nuevo Contrato</i></a>   
        </div>
        <div class="col-3">
            <a asp-asp-controller="Contrato" asp-action="Vencidos" title="Listado"><i class="btn btn-primary"> Vencidos/Finalizados</i></a>   
        </div>
    </div>
    <br>
    <br>
    </div>
</div>
    

<div class="accordion" id="accordionExample">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingOne">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
        <strong>Filtros</strong>
      </button>
    </h2>
    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        @using (Html.BeginForm ("Listado", "Contrato", FormMethod.Get)){
            
            <div class="container">
                <div class="row">
                     <div class="col-6"><label for="dir" class="control-label"><strong>Direccion:</strong></label>
                        <input name="dir" id="dir" type="text" class="form-control-sm" placeholder="formosa 255"> </input>
                        <br>
                    </div>
                    <div class="col-6">
                        <label for="dias" class="control-label "><strong>Contratos proximos a vencer:</strong></label>
                        <select  name="dias" id="dias" class="form-control-sm">
                            <option  value="" >Todos</option>
                            <option selected="@(ViewBag.dias==30)" value="30">30 dias</option>
                            <option selected="@(ViewBag.dias==60)" value="60">60 dias</option>
                            <option selected="@(ViewBag.dias==90)" value="90">90 dias</option>
                        </select>
                        <br>
                    </div>
                </div>
                <br>
                <br>
                <div class="row">
                    <div class="col-6"> 
                        <label for="fecInf" class="control-label "><strong>Fecha de Inicio:</strong></label>
                        <input type="datetime-local" class="form-control-sm mr-3" name="fecInf" id="fecInf">
                    </div>
                    <div class="col-6">
                        <label for="fecSup" class="control-label ml-3"><strong>Fecha de Finalizacion:</strong></label>
                        <input type="datetime-local" class="form-control-sm" name="fecSup" id="fecSup">
                    </div>
                    <br>
                    <br>
                </div>
                <div class="d-flex justify-content-end">
                    <div class="col-3 ">
                        <input type="submit" value="Filtrar" class="btn btn-lg btn-primary">
                    </div>
                    
                </div>
                
            </div>
            
        }
      </div>
    </div>
  </div>
</div>





<table class="table table-striped table-hover" style="width: 1400px;">
   
    <thead>
        <tr>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.InmuebleId)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.InquilinoId)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.FecInicio)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.FecFin)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Monto)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th style="text-align: center;">
                Editar
            </th>
            <th style="text-align: center;">
                Detalle
            </th>
            <th style="text-align: center;">
                Renovar
            </th>
            <th style="text-align: center;">Nuevo Pago

            </th>
            <th style="text-align: center;">
                Lista de Pagos
            </th>
            
            <th style="text-align: center;">
                Anular
            </th>
             @if(User.IsInRole("Administrador")){
                <th style="text-align: center;">
                    Eliminar
                </th>
            }
        </tr>
    </thead>
    <tbody class="table-group-divider">

@foreach (var item in Model) {
        <tr>
            <td style="text-align: center;">
                @(item.Inmueble.Direccion)
            </td>
            <td style="text-align: center;">
                @(item.Inquilino.Nombre + " " + item.Inquilino.Apellido)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.FecInicio)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.FecFin)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Monto)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Estado)
            </td>
            <td style="text-align: center;">
                <a asp-action="Editar" asp-route-id="@item.IdContrato" title="Editar" class="btn btn-primary"><i class="fa-solid fa-square-pen"></i></a>
            </td>
            <td style="text-align: center;">
				<a asp-action="Detalle" asp-route-id="@item.IdContrato" title="Detalle" class="btn btn-success"><i class="fa-solid fa-circle-info"></i></a>
			</td>
            <td style=" text-align: center;">
				<a asp-action="RenovarContrato" asp-route-id="@item.IdContrato" class="btn btn-warning"><i class="fa-solid fa-rotate-right"></i></a>
			</td>
            <td  style="text-align: center;">
                <a asp-controller="Pago" asp-action="Crear" asp-route-id="@item.IdContrato" class="btn btn-primary"><i class="fa-solid fa-coins"></i></a>
            </td>
            <td style="text-align: center;">
                <a asp-controller="Pago" asp-action="Listado" asp-route-id="@item.IdContrato" class="btn btn-success"><i class="fa-solid fa-list-check"></i></a>
            </td>
             <td style="text-align: center;">
                <a asp-controller="Contrato" asp-action="AnularContrato" asp-route-id="@item.IdContrato" class="btn btn-danger"><i class="fa-solid fa-ban"></i></a>
            </td>
            @if(User.IsInRole("Administrador")){
            <td style="text-align: center;">
                <a asp-action="Eliminar" asp-route-id="@item.IdContrato" title="Eliminar" class="btn btn-danger"><i class="fa-solid fa-trash-can"></i></a>
            </td>
            }
            
        </tr>
}
    </tbody>
</table>

