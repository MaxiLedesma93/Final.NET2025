@model Tp_Inmobiliaria_Ledesma_Lillo.Models.Pago;
@{
    ViewData["Title"] = "Detalles";
}
<h1>Detalles</h1>
<div>
    <h4>Pago</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdPago)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdPago)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NumPago)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NumPago)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaPago)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaPago)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Importe)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Importe)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ContratoId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ContratoId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Detalle)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Detalle)
        </dd>
    </dl>
</div>
@if(User.IsInRole("Administrador")){
    <div>
        <h4>Auditoria</h4>
        <hr>
        <dl class="row">
            <dt class="col-4">
                Email de usuario alta: 
            </dt>
            <dd class="col-8">
                @ViewBag.EmailUsuarioAlta
            </dd>
            <dt class="col-4">
                Email de usuario baja:
            </dt>
            <dd class="col-8">
                @ViewBag.EmailUsuarioBaja
            </dd>
            
        </dl>

    </div>
}
<div>
    @Html.ActionLink("Editar", "Editar", new { id = Model.IdPago}) |
    <a asp-action="Listado" asp-route-id="@Model.ContratoId">Volver al Listado</a>
</div>