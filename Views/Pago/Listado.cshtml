@model IEnumerable<Tp_Inmobiliaria_Ledesma_Lillo.Models.Pago>
@{
    ViewData["Title"] = "Pago";
}
@if(@Model.Count()>0){
    <div class="col-md-4">
        <form asp-controller="Pago" asp-action="PagosEliminados" asp-route-id="@Model.ElementAt(0).ContratoId">
            <div class="form-group">
            </div>
            <div class="form-group">
                <input type="submit" value="Pagos Anulados" class="btn btn-primary" />
            </div>
        </form> 
    </div> 
}
<br>           
<div>
<h1>Listado de Pagos</h1>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.NumPago)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Importe)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.FechaPago)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Detalle)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.ContratoId)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.contrato.Inquilino)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Activo)
            </th>
            <th style="text-align: center;">
                Editar
            </th>
            <th style="text-align: center;">
                Ver mas
            </th>
            <th style="text-align: center;">
                Anular
            </th>
            
        </tr>
    </thead>
    <tbody class="table-group-divider">
@foreach (var item in Model) {
        <tr>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.NumPago)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Importe)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.FechaPago)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Detalle)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.ContratoId)
            </td>
            <td style="text-align: center;">
                 @(item.contrato.Inquilino.Apellido + " " +item.contrato.Inquilino.Nombre)
            </td>
             <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Activo)
            </td>
            <td style="text-align: center;">
                <a asp-action="Editar" asp-route-id="@item.IdPago" title="Editar" class="btn btn-primary"><i class="fa-solid fa-square-pen"></i></a>
            </td>
            <td style="text-align: center;">
				<a asp-action="Detalle" asp-route-id="@item.IdPago" title="Detalle" class="btn btn-success"><i class="fa-solid fa-circle-info"></i></a>
			</td style="text-align: center;">
           
            <td style="text-align: center;">
                <a asp-action="Anular" asp-route-id="@item.IdPago" title="Anular" class="btn btn-danger"><i class="fa-solid fa-trash-can"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>