@model IEnumerable<Tp_Inmobiliaria_Ledesma_Lillo.Models.Inmueble>
@{
    ViewData["Title"] = "Inmueble";
}
<div>
	<h1>Inmuebles</h1>
<p>
     <a asp-action="Crear" title="Agregar Nuevo"><i class="btn btn-primary fa-solid fa-square-plus"></i></a>
</p>
<div class="accordion" id="accordionExample">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingOne">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
        <strong>Filtros</strong>
      </button>
    </h2>
    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
      <div class="accordion-body">
        @using (Html.BeginForm ("Listado", "Inmueble", FormMethod.Get)){
            
            <div class="container">
                <div class="row">
                    <div class="col-6">
                        <label for="listar" class="control-label "><h5><strong>Filtrar Inmuebles:</strong></h5></label>
                        <select  name="listar" id="listar" class="form-control-sm">
                            <option  value="" >Todos</option>
                            <option selected="@(ViewBag.listar=="disponibles")" value="disponibles">Disponibles</option>
                            <option selected="@(ViewBag.listar=="suspendidos")" value="suspendidos">Suspendidos</option>
                        </select>
                        <br>
                    </div>
                    <br>
                    <br>
                    <h5><strong>Inmuebles desocupados entre:</strong></h5>
                    <div class="col-3"> 
                        <label for="fecInf" class="control-label "><strong>Fecha de Inicio:</strong></label>
                        <input type="datetime-local" class="form-control-sm mr-3" name="fecInicio" id="fecInicio">
                    </div>
                    <div class="col-3">
                        <label for="fecSup" class="control-label ml-3"><strong>Fecha de Finalizacion:</strong></label>
                        <input type="datetime-local" class="form-control-sm" name="fecFin" id="fecFin">
                    </div>
                    <br>
                    <br>
                </div>
                <div class="d-flex justify-content-end">
                    <div class="col-3 ">
                        <input type="submit" value="Filtrar" class="btn btn-lg btn-primary">
                    </div>
                    
                </div>
                
            </div>
            
        }
      </div>
    </div>
  </div>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ambientes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Uso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PropietarioId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Importe)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Disponible)
            </th>
            <th>
                Editar
            </th>
            <th>
                Detalle
            </th>
            @if(User.IsInRole("Administrador")){
                <th style="text-align: center;">
                    Eliminar
                </th>
            }
        </tr>
    </thead>
    <tbody class="table-group-divider">
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Direccion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ambientes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Uso)
            </td>
            <td>
               @(item.TipoInmueble.Descripcion)
            </td>
            <td>
               @(item.Duenio.Nombre + " " + item.Duenio.Apellido)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Importe)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Disp)
            </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.IdInmueble" title="Editar" class="btn btn-primary"><i class="fa-solid fa-square-pen"></i></a>
                </td>
            <td>
				<a asp-action="Detalle" asp-route-id="@item.IdInmueble" title="Detalle" class="btn btn-success"><i class="fa-solid fa-circle-info"></i></a>
			</td>
            @if(User.IsInRole("Administrador")){
                <td>
                    <a asp-action="Eliminar" asp-route-id="@item.IdInmueble" title="Eliminar" class="btn btn-danger"><i class="fa-solid fa-trash-can"></i></a>
                </td>
            }
        </tr>
}
    </tbody>
</table>
</div>